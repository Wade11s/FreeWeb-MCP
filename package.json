{
  "name": "@wade11s/freeweb-mcp",
  "version": "0.2.1",
  "description": "Free-first local Web MCP using Firecrawl Local, TinyFish and ego-lite",
  "type": "module",
  "license": "MIT",
  "author": "Wade11s",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wade11s/FreeWeb-MCP.git"
  },
  "homepage": "https://github.com/Wade11s/FreeWeb-MCP#readme",
  "bugs": {
    "url": "https://github.com/Wade11s/FreeWeb-MCP/issues"
  },
  "keywords": [
    "mcp",
    "web",
    "firecrawl",
    "firecrawl-local",
    "tinyfish",
    "ego-lite",
    "web-scraping"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "freeweb-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "GLOSSARY.md",
    "docs/adr",
    "docs/providers",
    "docs/architecture.md",
    "docs/security.md",
    "docs/testing.md",
    "docs/review.md",
    "config.example.json"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts mcp",
    "start": "node dist/cli.js mcp",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run tests/integration",
    "test:live": "vitest run tests/live",
    "check": "npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "verify:pack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@tiny-fish/sdk": "^0.11.0",
    "commander": "~15.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  }
}
